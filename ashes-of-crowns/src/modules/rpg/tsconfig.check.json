{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "bundler", "lib": ["ES2022", "DOM"],
    "strict": true, "noUnusedLocals": true, "noUnusedParameters": true, "noImplicitReturns": true,
    "verbatimModuleSyntax": true, "isolatedModules": true, "erasableSyntaxOnly": true, "skipLibCheck": true, "noEmit": true
  },
  "include": ["./**/*.ts"], "exclude": ["tests"]
}
